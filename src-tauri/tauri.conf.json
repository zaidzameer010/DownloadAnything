{
  "$schema": "../ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DownloadAnything",
  "version": "0.7.0",
  "identifier": "downloadanything",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun --cwd=ui run dev",
    "beforeBuildCommand": "bun run backend:bundle && bun --cwd=ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DownloadAnything",
        "width": 1080,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/aria2-next"
    ],
    "resources": {
      "resources/backend/": "backend/",
      "resources/extension/": "extension/",
      "resources/venv/": "venv/",
      "resources/python/": "python/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zaidzameer010/DownloadAnything/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEQTM4MUE3Q0RBODc2Q0QKUldUTmRxak5wNEdqemEwZWswYWxSenlTYnB6OWhtQzFrVXIzdWhjQXR4VG4xSStrZmVVT1RzOW4K"
    }
  }
}
